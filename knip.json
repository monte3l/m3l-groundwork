{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@commitlint/config-conventional",
    "@commitlint/types"
  ],
  // wrangler is installed on the fly by docs.yml's deploy job from
  // .github/deploy-tools, never a dependency of this workspace; knip 6.38+
  // flags the node_modules/.bin/wrangler path in that workflow.
  "ignoreBinaries": ["verify", "build", "wrangler"],
  "workspaces": {
    ".": {
      "entry": [
        "bin/*.mjs",
        ".claude/hooks/*.mjs",
        // Unlike a bin/lib/*.mjs helper fully covered by a real entry
        // script's own static imports, design-tokens.mjs is a general-purpose
        // DTCG resolver whose full API is exercised only from
        // packages/cli/tests/design-tokens*.test.ts, via a dynamic
        // `import(pathToFileURL(...))` (the same load-by-URL pattern
        // eval-lib.test.ts uses for its own bin/lib module -- see that
        // file's header). Knip's static analysis cannot trace a property read
        // off a dynamically-imported module object back to a named export
        // the way it traces a same-language `import {...}` -- without this
        // entry, several exports used only by that test file
        // (mergeTokenTrees, resolveTree, isColorValue, DesignTokenError)
        // report as unused.
        "bin/lib/design-tokens.mjs",
        // Same reason, same dynamic-import pattern, from
        // packages/cli/tests/markdown*.test.ts: without this entry,
        // slugifyHeading (used only via that test file's dynamically
        // imported module object) reports as unused.
        "bin/lib/markdown.mjs",
        // Same reason, same dynamic-import pattern, from
        // packages/cli/tests/site-headers*.test.ts: without this entry,
        // HeadersLimitError (thrown, not imported, by bin/build-docs.mjs's
        // production usage) and assertHeadersLimits (called inside
        // buildHeadersFile, exercised directly by the tests) report as unused.
        "bin/lib/site-headers.mjs",
        // Same reason, same dynamic-import pattern, from
        // packages/cli/tests/eval-lib.test.ts: listPackSkillDirs's only
        // static consumer used to be bin/eval.mjs and
        // bin/make-harness-plugin.mjs directly; once both were refactored to
        // go through packsHarnessParams (eval-lib.mjs's own shared param
        // builder) instead, its only remaining static consumer is inside
        // eval-lib.mjs itself, so it reports as unused without this entry.
        "bin/lib/eval-lib.mjs",
        // Same reason, same dynamic-import pattern, from
        // packages/cli/tests/ci-docs-only.test.ts: isDocsOnly's only static
        // consumer is docsOnlyFor, inside ci-scope.mjs itself, so it reports
        // as unused without this entry.
        "bin/lib/ci-scope.mjs"
      ],
      "project": ["bin/**/*.mjs", ".claude/hooks/**/*.mjs"]
    },
    "packages/cli": {
      "entry": ["src/main.ts", "bin/*.mjs", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "bin/**/*.mjs", "scripts/**/*.mjs"]
    },
    "packages/plugin": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
