{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "signoff": "monte3l-release[bot] <333264726+monte3l-release[bot]@users.noreply.github.com>",
  "bootstrap-sha": "8f808619d6ca299859e12ae6962959faf0eee20f",
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "@monte3l/groundwork",
      "include-component-in-tag": true,
      "tag-separator": "@",
      "include-v-in-tag": false,
      "changelog-path": "packages/cli/CHANGELOG.md",
      "draft": true,
      "force-tag-creation": true,
      "exclude-paths": [
        ".claude",
        ".github",
        "LICENSES",
        "bin",
        "design",
        "docs",
        "evals",
        "tools"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/plugin/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
