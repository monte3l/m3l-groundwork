{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false,
    // isolatedDeclarations stays out of the base config deliberately: the
    // build project sets it individually (see tsconfig.build.json), but the
    // tooling project (tsconfig.json) sets declaration: false and includes
    // tests/, which isolatedDeclarations does not tolerate.
    //
    // noUnusedLocals / noUnusedParameters are deliberately NOT set:
    // @typescript-eslint/no-unused-vars already covers both at error level
    // (eslint.config.js) with an `^_`-prefix escape hatch this codebase
    // relies on; tsc's flags honor no such pattern for locals.
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
