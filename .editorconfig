root = true

# Matches Prettier's defaults on purpose: Prettier reads this file, so a value
# here that differs from them would reformat the whole repository.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
