# Dependencies
node_modules/

# Build output (tsc-owned; never committed)
dist/
*.tsbuildinfo

# Copied into packages/cli for the length of a `pnpm pack` (prepack/postpack)
packages/cli/templates/
packages/cli/plugin/
packages/cli/LICENSE

# Test / coverage artifacts
coverage/

# Editor / OS
.DS_Store

# Local overrides
lefthook-local.yml

# A worktree the harness creates (`claude --worktree`, Agent tool
# `isolation: "worktree"`, or `EnterWorktree`) lands under here as a full,
# independent checkout -- see .prettierignore/eslint.config.js/vitest.config.ts
# for why every tool that walks this tree already excludes it.
.claude/worktrees/

# Adopt mode's own output, from testing it against this repo itself
.groundwork/

# `pnpm eval` results (behavioural harness evals)
.eval-results/
packages/plugin/evals/results/

# The docs site build output (`node bin/build-docs.mjs --out _site`, the
# staging directory `.github/workflows/docs.yml`'s build job uploads as an
# artifact for the deploy job to pick up) -- generated, never committed.
_site/

# Wrangler's local cache/state dir (`.github/deploy-tools/wrangler.jsonc`'s
# working directory) -- generated by `wrangler deploy`/`wrangler dev`.
# (.github/deploy-tools/node_modules/ is already covered by the blanket
# node_modules/ rule above.)
.github/deploy-tools/.wrangler/
