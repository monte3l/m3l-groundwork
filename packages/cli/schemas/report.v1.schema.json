{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.monte3l.com/schemas/report.v1.schema.json",
  "title": "groundwork.report v1",
  "description": "The one JSON document a --json run of @monte3l/groundwork writes to stdout. Every field is always present, in this order. changes is always empty, and handoff and drift have no defined entry shape yet, until --apply ships. pending is empty except for an adopt survey run with --json, which lists the decisions it wrote to .groundwork/headless/pending.json (artifacts.pending).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "cliVersion",
    "mode",
    "phase",
    "dryRun",
    "status",
    "exitCode",
    "target",
    "artifacts",
    "changes",
    "pending",
    "handoff",
    "drift",
    "setupSteps",
    "warnings",
    "nextStep",
    "error"
  ],
  "properties": {
    "schema": { "const": "groundwork.report" },
    "schemaVersion": { "const": 1 },
    "cliVersion": { "type": "string" },
    "mode": { "enum": ["fresh", "adopt", "upgrade", null] },
    "phase": { "enum": ["survey", "plan", "apply", "stamp", null] },
    "dryRun": { "type": "boolean" },
    "status": {
      "enum": ["ok", "noop", "pending", "drift", "error", "usage"]
    },
    "exitCode": { "enum": [0, 1, 2, 3, 4] },
    "target": { "type": ["string", "null"] },
    "artifacts": {
      "description": "Where the run left each artifact, relative to target; null when not written.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory",
        "manifest",
        "plan",
        "pending",
        "commitMsg",
        "prBody"
      ],
      "properties": {
        "inventory": { "type": ["string", "null"] },
        "manifest": { "type": ["string", "null"] },
        "plan": { "type": ["string", "null"] },
        "pending": { "type": ["string", "null"] },
        "commitMsg": { "type": ["string", "null"] },
        "prBody": { "type": ["string", "null"] }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "class", "sha256Before", "sha256After"],
        "properties": {
          "path": { "type": "string" },
          "action": { "type": "string" },
          "class": { "type": "string" },
          "sha256Before": { "type": ["string", "null"] },
          "sha256After": { "type": ["string", "null"] }
        }
      }
    },
    "pending": {
      "description": "The decisions still missing: the same PendingEntry objects as the pending list of the answers document named by artifacts.pending, in the same order. Empty when no pending document was written.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pointer", "reason", "choices", "evidence"],
        "properties": {
          "pointer": { "type": "string" },
          "reason": { "type": "string" },
          "choices": {
            "anyOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "null" }
            ]
          },
          "evidence": { "type": ["string", "null"] }
        }
      }
    },
    "handoff": { "type": "array" },
    "drift": { "type": "array" },
    "setupSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack", "steps"],
        "properties": {
          "pack": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "nextStep": { "type": ["string", "null"] },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["message", "chain"],
          "properties": {
            "message": { "type": "string" },
            "chain": { "type": "array", "items": { "type": "string" } }
          }
        },
        { "type": "null" }
      ]
    }
  }
}
