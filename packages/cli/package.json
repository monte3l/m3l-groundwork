{
  "name": "@monte3l/groundwork",
  "version": "1.1.2",
  "description": "A CLI that sets up a TypeScript project with a strict toolchain and Claude Code, or surveys an existing one read-only, plus a /customize skill that tailors it to current guidance",
  "keywords": [
    "bootstrap",
    "claude-code",
    "claude-code-plugin",
    "cli",
    "developer-tools",
    "scaffolding",
    "typescript"
  ],
  "homepage": "https://groundwork.monte3l.com",
  "bugs": {
    "url": "https://github.com/monte3l/m3l-groundwork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monte3l/m3l-groundwork.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Enrico Lionello",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "m3l-groundwork": "bin/m3l-groundwork.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "bin",
    "templates",
    "plugin",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "node scripts/vendor-assets.mjs vendor",
    "postpack": "node scripts/vendor-assets.mjs clean"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
