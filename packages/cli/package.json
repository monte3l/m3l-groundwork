{
  "name": "@monte3l/groundwork",
  "version": "1.0.0-rc.2",
  "description": "CLI that writes a TypeScript toolchain and Claude Code setup into an empty directory, or -- against an existing project -- read-only surveys it and reports the differences. No prompts, and no network access beyond the package install.",
  "keywords": [
    "typescript",
    "claude-code",
    "bootstrap",
    "scaffold",
    "cli"
  ],
  "homepage": "https://github.com/monte3l/m3l-groundwork#readme",
  "bugs": {
    "url": "https://github.com/monte3l/m3l-groundwork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monte3l/m3l-groundwork.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Enrico Lionello",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "m3l-groundwork": "bin/m3l-groundwork.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "bin",
    "templates",
    "plugin"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "node scripts/vendor-assets.mjs vendor",
    "postpack": "node scripts/vendor-assets.mjs clean"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
