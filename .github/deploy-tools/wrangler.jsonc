{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare's own recommendation for a new static site as of late 2026:
  // Workers Static Assets, not Pages (Pages is in maintenance -- see
  // docs/cloudflare-docs.md). No "main" script is needed for an
  // assets-only Worker.
  "name": "m3l-groundwork-docs",
  "compatibility_date": "2026-09-27",
  "assets": {
    // Resolved relative to this file (.github/deploy-tools/), so it points
    // at the _site/ directory the workflow's build job writes at the repo
    // root before this deploy job downloads its artifact there.
    "directory": "../../_site",
    "html_handling": "auto-trailing-slash",
    // bin/build-docs.mjs emits a real 404.html at the site root; without
    // this, a missing path would silently fall through to index.html.
    "not_found_handling": "404-page",
  },
  "routes": [
    // A Custom Domain: Cloudflare creates the DNS record and an Advanced
    // Certificate automatically. The hostname must carry no existing CNAME
    // record in the zone (see docs/cloudflare-docs.md's one-time setup).
    { "pattern": "groundwork.monte3l.com", "custom_domain": true },
  ],
  // Both false: this is a public repo, and a workers.dev / version preview
  // URL is public by default with no way to restrict it on the Free plan.
  "workers_dev": false,
  "preview_urls": false,
}
